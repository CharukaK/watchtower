{
  "name": "watchtower",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i ./styles/app.css -o ./web/static/app.css --minify",
    "css:watch": "tailwindcss -i ./styles/app.css -o ./web/static/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
