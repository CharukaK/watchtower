package dashboard

import "fmt"
import "time"
import "github.com/CharukaK/watchtower/internal/ui"
import "github.com/CharukaK/watchtower/internal/backend/isapi"
import "github.com/CharukaK/watchtower/internal/backend/mediamtx"

templ Dashboard(
	info isapi.DeviceInfo,
	mediamtxInfo mediamtx.Info,
	channels []isapi.StreamingChannel,
) {
	@ui.MainLayout("Watchtower") {
		@dashboardShell(info, mediamtxInfo, channels, cameraViews(channels))
	}
}

templ dashboardShell(
	info isapi.DeviceInfo,
	mediamtxInfo mediamtx.Info,
	channels []isapi.StreamingChannel,
	cameras []cameraView,
) {
	<div
		class="app-shell"
		data-signals:screen="'dashboard'"
		data-signals:columns="'2'"
		data-signals:camera-name="'Camera detail'"
		data-signals:camera-meta="'Select a camera from the live dashboard'"
		data-signals:camera-codec="'—'"
		data-signals:camera-resolution="'—'"
		data-signals:stream-url="''"
		data-signals:snapshot-url="''"
	>
		<aside class="sidebar">
			<div class="brand"><span class="brand-mark" aria-hidden="true"></span>Watchtower</div>
			<nav class="nav" aria-label="Main navigation">
				<button class="nav-button" type="button" data-class:active="$screen === 'dashboard'" data-on:click="$screen = 'dashboard'">Live dashboard</button>
				<button class="nav-button" type="button" data-class:active="$screen === 'camera'" data-on:click="$screen = 'camera'">Camera detail</button>
				<button class="nav-button" type="button" data-class:active="$screen === 'replay'" data-on:click="$screen = 'replay'">Replay</button>
			</nav>
			<div class="system-card">
				<div class="status-row"><span class="status-dot"></span><strong>DVR connected</strong></div>
				<p class="muted tiny">{ fmt.Sprintf("%d cameras available", len(cameras)) }<br/>MediaMTX { mediamtxInfo.Version }</p>
			</div>
		</aside>

		<main class="app-main">
			<section class="screen" id="dashboard" aria-labelledby="dashboard-title" data-show="$screen === 'dashboard'">
				<header class="topbar">
					<div>
						<h1 id="dashboard-title">Live cameras</h1>
						<p class="muted">{ time.Now().Format("Monday, January 2 · 3:04 PM") }</p>
					</div>
					<div class="actions">
						<label class="sr-only" for="grid-size">Grid size</label>
						<select class="select" id="grid-size" data-bind:columns>
							<option value="2">2 columns</option>
							<option value="3">3 columns</option>
						</select>
						<button class="button" type="button" data-on:click="window.location.reload()">Refresh</button>
					</div>
				</header>

				<div class="dashboard-layout">
					<div class="camera-grid" id="camera-grid" data-class:compact="$columns === '3'">
						if len(cameras) == 0 {
							<div class="empty-state panel">
								<h2>No cameras available</h2>
								<p class="muted">Watchtower did not find an enabled stream on the DVR.</p>
							</div>
						}
						for _, camera := range cameras {
							<article
								class="camera-card"
								role="button"
								tabindex="0"
								aria-label={ fmt.Sprintf("Open %s camera", camera.Name) }
								data-open-camera
								data-camera-name={ camera.Name }
								data-camera-meta={ fmt.Sprintf("Camera %d · Stream %d", camera.InputChannelID, camera.StreamID) }
								data-camera-codec={ camera.Codec }
								data-camera-resolution={ camera.Resolution }
								data-stream-url={ camera.StreamURL }
								data-snapshot-url={ camera.SnapshotURL }
								data-on:click="$cameraName = evt.currentTarget.dataset.cameraName; $cameraMeta = evt.currentTarget.dataset.cameraMeta; $cameraCodec = evt.currentTarget.dataset.cameraCodec; $cameraResolution = evt.currentTarget.dataset.cameraResolution; $streamUrl = evt.currentTarget.dataset.streamUrl; $snapshotUrl = evt.currentTarget.dataset.snapshotUrl; $screen = 'camera'"
								data-on:keydown="(evt.key === 'Enter' || evt.key === ' ') && (evt.preventDefault(), evt.currentTarget.click())"
							>
								<div class="feed">
									<iframe
										src={ templ.SafeURL(camera.PreviewStreamURL) }
										title={ fmt.Sprintf("Live view for %s", camera.Name) }
										loading="lazy"
										allow="autoplay; fullscreen; picture-in-picture"
										allowfullscreen
									></iframe>
									<span class="feed-badge"><span class="status-dot"></span>Live</span>
								</div>
								<div class="camera-meta">
									<div><h2>{ camera.Name }</h2><p>{ fmt.Sprintf("Camera %d · Online", camera.InputChannelID) }</p></div>
									<span class="quality">{ camera.PreviewCodec }</span>
								</div>
							</article>
						}
					</div>

					<aside class="event-panel">
						<div class="panel-header"><h2>Recent events</h2><span class="muted tiny">Not connected</span></div>
						<div class="empty-panel">
							<span class="event-icon" aria-hidden="true">○</span>
							<strong>No live event feed</strong>
							<p class="muted tiny">Motion and video-loss events will appear here after the ISAPI event stream is connected.</p>
						</div>
					</aside>
				</div>

				<details class="panel admin-details">
					<summary>Device and stream details</summary>
					<div class="system-summary">
						<div><span class="muted tiny">Device</span><strong>{ info.Name }</strong><span class="muted tiny">{ info.Model } · { info.Firmware }</span></div>
						<div><span class="muted tiny">Media server</span><strong>MediaMTX { mediamtxInfo.Version }</strong><span class="muted tiny">Started { mediamtxInfo.Started.Format(time.RFC1123) }</span></div>
					</div>
					@channelsTable(channels)
				</details>
			</section>

			<section class="screen" id="camera" aria-labelledby="camera-title" data-show="$screen === 'camera'" style="display: none">
				<header class="topbar">
					<div>
						<button class="button tiny back-button" type="button" data-on:click="$screen = 'dashboard'">← All cameras</button>
						<h1 id="camera-title" data-text="$cameraName">Camera detail</h1>
						<p class="muted" id="camera-subtitle" data-text="$cameraMeta">Select a camera from the live dashboard</p>
					</div>
					<div class="actions">
						<button class="button" type="button" data-on:click="$screen = 'replay'">View replay</button>
						<a class="button primary disabled" id="snapshot-link" href="#" download aria-disabled="true" data-attr:href="$snapshotUrl || '#'" data-attr:aria-disabled="!$snapshotUrl" data-class:disabled="!$snapshotUrl">Take snapshot</a>
					</div>
				</header>

				<div class="detail-layout">
					<section class="panel player-panel">
						<div class="large-feed" id="detail-feed" data-class:has-player="!!$streamUrl">
							<div class="placeholder" id="detail-placeholder"><strong>No camera selected</strong>Choose a camera from the dashboard.</div>
							<iframe id="detail-player" title="Selected live camera" data-attr:src="$streamUrl" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
							<span class="feed-badge"><span class="status-dot"></span>Live</span>
						</div>
						<div class="player-controls"><span class="live-pulse" aria-hidden="true"></span><strong class="tiny">LIVE</strong><span class="player-spacer"></span><span class="tiny muted" id="detail-quality" data-text="$streamUrl ? $cameraCodec + ' · ' + $cameraResolution : 'Waiting for camera'">Waiting for camera</span></div>
					</section>

					<aside class="detail-sidebar">
						<section class="panel">
							<div class="panel-header"><h2>Camera status</h2></div>
							<div class="stats">
								<div class="stat"><span class="muted">Connection</span><span class="row"><span class="status-dot"></span>Online</span></div>
								<div class="stat"><span class="muted">Codec</span><span id="detail-codec" data-text="$cameraCodec">—</span></div>
								<div class="stat"><span class="muted">Resolution</span><span id="detail-resolution" data-text="$cameraResolution">—</span></div>
								<div class="stat"><span class="muted">Recording</span><span>Managed by DVR</span></div>
							</div>
						</section>
						<section class="panel">
							<div class="panel-header"><h2>Latest activity</h2></div>
							<div class="empty-panel compact"><p class="muted tiny">Event history is not connected yet.</p></div>
						</section>
					</aside>
				</div>
			</section>

			<section class="screen" id="replay" aria-labelledby="replay-title" data-show="$screen === 'replay'" style="display: none">
				<header class="topbar">
					<div><h1 id="replay-title">Recording replay</h1><p class="muted">Search the DVR by camera and local time</p></div>
					<button class="button" type="button" data-on:click="$screen = 'dashboard'">Back to live</button>
				</header>

				<div class="replay-layout">
					<aside class="panel filters">
						<h2>Find recordings</h2>
						<div class="field">
							<label for="camera-select">Camera</label>
							<select class="select" id="camera-select">
								for _, camera := range cameras {
									<option>{ camera.Name }</option>
								}
							</select>
						</div>
						<div class="field"><label for="replay-date">Date</label><input class="input" id="replay-date" type="date" value={ time.Now().Format("2006-01-02") }/></div>
						<div class="field"><label for="start-time">Start time</label><input class="input" id="start-time" type="time" value="10:00"/></div>
						<div class="field"><label for="end-time">End time</label><input class="input" id="end-time" type="time" value="13:00"/></div>
						<button class="button primary full-width" type="button" disabled>Search recordings</button>
						<p class="muted tiny field-note">Recording search is not connected to the DVR yet.</p>
					</aside>

					<div class="replay-main">
						<section class="panel replay-video">
							<div class="large-feed replay-placeholder"><div class="placeholder"><div><strong>Playback unavailable</strong>Connect the ISAPI recording search and playback relay to enable replay.</div></div></div>
							<div class="player-controls"><button class="button icon" type="button" disabled aria-label="Play">▶</button><div class="scrubber" aria-hidden="true"></div><span class="tiny muted">No recording selected</span></div>
						</section>
						<section class="panel timeline-wrap">
							<div class="panel-title-row"><h2>Recording timeline</h2><span class="muted tiny">No segments</span></div>
							<div class="timeline-labels"><span>10:00</span><span>11:00</span><span>12:00</span><span>13:00</span></div>
							<div class="timeline empty" aria-label="Recording timeline"></div>
						</section>
					</div>
				</div>
			</section>
		</main>
	</div>
}
