package dashboard

import "fmt"
import "github.com/CharukaK/watchtower/internal/ui"
import "github.com/CharukaK/watchtower/internal/backend/isapi"
import "github.com/CharukaK/watchtower/internal/backend/mediamtx"

templ Dashboard(
	info isapi.DeviceInfo,
	mediamtxInfo mediamtx.Info,
	channels []isapi.StreamingChannel,
) {
	@ui.MainLayout("Watchtower") {
		@dashboardShell(info, mediamtxInfo, channels, cameraViews(channels))
	}
}

templ dashboardShell(
	info isapi.DeviceInfo,
	mediamtxInfo mediamtx.Info,
	channels []isapi.StreamingChannel,
	cameras []cameraView,
) {
	<div
		class="app-shell"
		data-signals:screen="'dashboard'"
		data-signals:columns="'2'"
		data-signals:camera-name="'Camera detail'"
		data-signals:camera-meta="'Select a camera from the live dashboard'"
		data-signals:camera-codec="'—'"
		data-signals:camera-resolution="'—'"
		data-signals:stream-url="''"
		data-signals:snapshot-url="''"
	>
		@dashboardSidebar(mediamtxInfo, cameras)
		<main class="app-main">
			@liveDashboard(info, mediamtxInfo, channels, cameras)
			@cameraDetail()
			@replayScreen(cameras)
		</main>
	</div>
}

templ dashboardSidebar(mediamtxInfo mediamtx.Info, cameras []cameraView) {
	<aside class="sidebar">
		<div class="brand">
			<span class="brand-mark" aria-hidden="true"></span>
			Watchtower
		</div>
		<nav class="nav" aria-label="Main navigation">
			<button
				class="nav-button"
				type="button"
				data-class:active="$screen === 'dashboard'"
				data-on:click="$screen = 'dashboard'"
			>
				Live dashboard
			</button>
			<button
				class="nav-button"
				type="button"
				data-class:active="$screen === 'camera'"
				data-on:click="$screen = 'camera'"
			>
				Camera detail
			</button>
			<button
				class="nav-button"
				type="button"
				data-class:active="$screen === 'replay'"
				data-on:click="$screen = 'replay'"
			>
				Replay
			</button>
		</nav>
		<div class="system-card">
			<div class="status-row">
				<span class="status-dot"></span>
				<strong>DVR connected</strong>
			</div>
			<p class="muted tiny">
				{ fmt.Sprintf("%d cameras available", len(cameras)) }
				<br/>
				MediaMTX { mediamtxInfo.Version }
			</p>
		</div>
	</aside>
}
