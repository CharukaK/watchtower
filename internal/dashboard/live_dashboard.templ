package dashboard

import "fmt"
import "time"
import "github.com/CharukaK/watchtower/internal/backend/isapi"
import "github.com/CharukaK/watchtower/internal/backend/mediamtx"

templ liveDashboard(
	info isapi.DeviceInfo,
	mediamtxInfo mediamtx.Info,
	channels []isapi.StreamingChannel,
	cameras []cameraView,
) {
	<section
		class="screen"
		id="dashboard"
		aria-labelledby="dashboard-title"
		data-show="$screen === 'dashboard'"
	>
		<header class="topbar">
			<div>
				<h1 id="dashboard-title">Live cameras</h1>
				<p class="muted">{ time.Now().Format("Monday, January 2 · 3:04 PM") }</p>
			</div>
			<div class="actions">
				<label class="sr-only" for="grid-size">Grid size</label>
				<select class="select" id="grid-size" data-bind:columns>
					<option value="2">2 columns</option>
					<option value="3">3 columns</option>
				</select>
				<button
					class="button"
					type="button"
					data-on:click="window.location.reload()"
				>
					Refresh
				</button>
			</div>
		</header>
		<div class="dashboard-layout">
			<div
				class="camera-grid"
				id="camera-grid"
				data-class:compact="$columns === '3'"
			>
				if len(cameras) == 0 {
					<div class="empty-state panel">
						<h2>No cameras available</h2>
						<p class="muted">Watchtower did not find an enabled stream on the DVR.</p>
					</div>
				}
				for _, camera := range cameras {
					@cameraCard(camera)
				}
			</div>
			<aside class="event-panel">
				<div class="panel-header">
					<h2>Recent events</h2>
					<span class="muted tiny">Not connected</span>
				</div>
				<div class="empty-panel">
					<span class="event-icon" aria-hidden="true">○</span>
					<strong>No live event feed</strong>
					<p class="muted tiny">
						Motion and video-loss events will appear here after the ISAPI event stream is connected.
					</p>
				</div>
			</aside>
		</div>
		<details class="panel admin-details">
			<summary>Device and stream details</summary>
			<div class="system-summary">
				<div>
					<span class="muted tiny">Device</span>
					<strong>{ info.Name }</strong>
					<span class="muted tiny">{ info.Model } · { info.Firmware }</span>
				</div>
				<div>
					<span class="muted tiny">Media server</span>
					<strong>MediaMTX { mediamtxInfo.Version }</strong>
					<span class="muted tiny">
						Started { mediamtxInfo.Started.Format(time.RFC1123) }
					</span>
				</div>
			</div>
			@channelsTable(channels)
		</details>
	</section>
}

templ cameraCard(camera cameraView) {
	<article
		class="camera-card"
		role="button"
		tabindex="0"
		aria-label={ fmt.Sprintf("Open %s camera", camera.Name) }
		data-open-camera
		data-camera-name={ camera.Name }
		data-camera-meta={ fmt.Sprintf("Camera %d · Stream %d", camera.InputChannelID, camera.StreamID) }
		data-camera-codec={ camera.Codec }
		data-camera-resolution={ camera.Resolution }
		data-stream-url={ camera.StreamURL }
		data-snapshot-url={ camera.SnapshotURL }
		data-on:click="$cameraName = evt.currentTarget.dataset.cameraName; $cameraMeta = evt.currentTarget.dataset.cameraMeta; $cameraCodec = evt.currentTarget.dataset.cameraCodec; $cameraResolution = evt.currentTarget.dataset.cameraResolution; $streamUrl = evt.currentTarget.dataset.streamUrl; $snapshotUrl = evt.currentTarget.dataset.snapshotUrl; $screen = 'camera'"
		data-on:keydown="(evt.key === 'Enter' || evt.key === ' ') && (evt.preventDefault(), evt.currentTarget.click())"
	>
		<div class="feed">
			<iframe
				src={ templ.SafeURL(camera.PreviewStreamURL) }
				title={ fmt.Sprintf("Live view for %s", camera.Name) }
				loading="lazy"
				allow="autoplay; fullscreen; picture-in-picture"
				allowfullscreen
			></iframe>
			<span class="feed-badge">
				<span class="status-dot"></span>
				Live
			</span>
		</div>
		<div class="camera-meta">
			<div>
				<h2>{ camera.Name }</h2>
				<p>{ fmt.Sprintf("Camera %d · Online", camera.InputChannelID) }</p>
			</div>
			<span class="quality">{ camera.PreviewCodec }</span>
		</div>
	</article>
}
