# DVR or camera address. Prefer a LAN IP because .local names may not resolve in containers.
HOST_URL=http://192.168.1.20
DVR_USER=admin
DVR_PASSWORD=change-me

# Use a long, unique value. This protects the MediaMTX control API.
MEDIAMTX_PASSWORD=change-me-too

# LAN IP or DNS name of this machine, reachable by viewing browsers.
WEBRTC_ADDITIONAL_HOST=192.168.1.10

# Keep this on loopback for access from this machine only.
# Set it to this machine's LAN IP to allow other trusted LAN devices.
WATCHTOWER_BIND_ADDRESS=127.0.0.1
WATCHTOWER_PORT=8080
